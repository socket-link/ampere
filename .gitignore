*.iml
*.db
# SQLDelight schema snapshots that verifySqlDelightMigration checks migrations against.
!ampere-core/src/commonMain/sqldelight/databases/*.db
.gradle
.kotlin/
# A developer's local .ampere/config.yaml can hold credentials, so the directory
# stays ignored by default. verify.yml is the one tracked file in it: the
# repository's declared definition of done (docs/verify-manifest.md). Git cannot
# re-include a path under an excluded directory, so this is `/*` plus a negation
# rather than a bare `.ampere`.
.ampere/*
!.ampere/verify.yml
/local.properties
/.idea
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
ampere.yaml
ampere-ios/Podfile.lock
ampere-ios/Pods/*
ampere-ios/ampere-ios.xcworkspace/*
ampere-ios/ampere-ios.xcodeproj/*
!ampere-ios/ampere-ios.xcodeproj/project.pbxproj
ampere-core/ampere-core.podspec
