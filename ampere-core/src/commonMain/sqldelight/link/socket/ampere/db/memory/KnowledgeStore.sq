-- Knowledge Store table
-- Stores Knowledge entries extracted from Ideas, Outcomes, Perceptions, Plans, and Tasks
-- Enables semantic retrieval for agent learning and decision-making

CREATE TABLE IF NOT EXISTS KnowledgeStore (
    id TEXT PRIMARY KEY NOT NULL,

    -- Discriminator for polymorphic Knowledge sealed class
    -- Values: FROM_IDEA, FROM_OUTCOME, FROM_PERCEPTION, FROM_PLAN, FROM_TASK
    knowledge_type TEXT NOT NULL,

    -- Common fields across all Knowledge types
    approach TEXT NOT NULL,
    learnings TEXT NOT NULL,
    timestamp INTEGER NOT NULL, -- Unix epoch milliseconds
    run_id TEXT,

    -- Type-specific foreign key IDs (only one will be non-null based on knowledge_type)
    idea_id TEXT,
    outcome_id TEXT,
    perception_id TEXT,
    plan_id TEXT,
    task_id TEXT,

    -- Denormalized fields for efficient querying
    task_type TEXT,           -- Extracted from associated task context
    complexity_level TEXT,    -- TRIVIAL, SIMPLE, MODERATE, COMPLEX, NOVEL

    -- Belief columns (F9-F12, AMPR-417), added by 10.sqm. Declared last because ADD COLUMN can
    -- only append and every read here is a SELECT * mapped by position (see 4.sqm).
    holder TEXT NOT NULL DEFAULT 'system',  -- the Subject holding this; rows older than 10.sqm are `system`'s
    confidence REAL,                        -- already mapped (F10); NULL when nothing reported one
    sensitivity TEXT NOT NULL DEFAULT 'PUBLIC',  -- PUBLIC | PRIVATE | PROTECTED (`field.Sensitivity`; no CHECK, see 10.sqm)
    created_by_event TEXT                   -- the KnowledgeStored event that recorded this row (F11)
);

-- Indexes for common query patterns
CREATE INDEX IF NOT EXISTS idx_knowledge_type ON KnowledgeStore(knowledge_type);
CREATE INDEX IF NOT EXISTS idx_knowledge_timestamp ON KnowledgeStore(timestamp DESC);
CREATE INDEX IF NOT EXISTS idx_knowledge_run_id ON KnowledgeStore(run_id);
CREATE INDEX IF NOT EXISTS idx_knowledge_task_type ON KnowledgeStore(task_type);
CREATE INDEX IF NOT EXISTS idx_knowledge_complexity ON KnowledgeStore(complexity_level);
CREATE INDEX IF NOT EXISTS idx_knowledge_holder ON KnowledgeStore(holder);
CREATE INDEX IF NOT EXISTS idx_knowledge_created_by_event ON KnowledgeStore(created_by_event);

-- Tags associated with knowledge entries (many-to-many for flexible categorization)
CREATE TABLE IF NOT EXISTS KnowledgeTag (
    knowledge_id TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (knowledge_id, tag),
    FOREIGN KEY (knowledge_id) REFERENCES KnowledgeStore(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_knowledge_tag_tag ON KnowledgeTag(tag);
CREATE INDEX IF NOT EXISTS idx_knowledge_tag_knowledge_id ON KnowledgeTag(knowledge_id);

-- Full-text search support for approach and learnings.
--
-- The `KnowledgeFts` virtual table + sync triggers used to be declared here as
-- `CREATE VIRTUAL TABLE ... USING fts5`. That DDL now lives in
-- link.socket.ampere.db.fts.FtsSchema, installed as a separate guarded step after
-- `Schema.create()` returns, so a SQLite build without the fts5 module (e.g. Android's system
-- SQLite) degrades search instead of taking the whole schema down. See AMPR-325.

-- =============================================================================
-- KNOWLEDGE STORE QUERIES
-- =============================================================================

-- Insert a knowledge entry. Every column is named: a writer states who holds the row, how
-- sensitive it is and which event recorded it, rather than inheriting the backfill defaults.
insertKnowledge:
INSERT INTO KnowledgeStore (
    id, knowledge_type, approach, learnings, timestamp, run_id,
    idea_id, outcome_id, perception_id, plan_id, task_id,
    task_type, complexity_level,
    holder, confidence, sensitivity, created_by_event
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Insert tag association
insertKnowledgeTag:
INSERT OR IGNORE INTO KnowledgeTag (knowledge_id, tag) VALUES (?, ?);

-- -----------------------------------------------------------------------------
-- Reads.
--
-- A read on behalf of a Subject names it as :viewer and sees every PUBLIC row plus the rows
-- that viewer holds itself: another Subject's PRIVATE and PROTECTED rows never come back
-- (F12, AMPR-417). A NULL viewer is nobody, and sees PUBLIC rows only. The predicate is
-- written into each query rather than applied after the LIMIT, so a viewer is never handed a
-- short page because someone else's rows took the slots.
--
-- The replay reads (findKnowledgeByRunId, getReplayableKnowledgeById) take no viewer: a
-- replay or bake is nobody's view, so it gets PRIVATE rows of the run it replays but never a
-- PROTECTED one.
-- -----------------------------------------------------------------------------

-- Retrieve knowledge by ID
getKnowledgeById:
SELECT * FROM KnowledgeStore
WHERE id = :id
AND (sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND holder = :viewer));

-- The replay read of one row: the projection's lookup for a KnowledgeStored it folds.
getReplayableKnowledgeById:
SELECT * FROM KnowledgeStore
WHERE id = ? AND sensitivity != 'PROTECTED';

-- Get tags for a knowledge entry
getTagsForKnowledge:
SELECT tag FROM KnowledgeTag WHERE knowledge_id = ? ORDER BY tag;

-- Find knowledge by type (e.g., all FROM_OUTCOME learnings)
findKnowledgeByType:
SELECT * FROM KnowledgeStore
WHERE knowledge_type = :knowledge_type
AND (sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND holder = :viewer))
ORDER BY timestamp DESC
LIMIT :limit;

-- Find knowledge within timestamp range
findKnowledgeByTimeRange:
SELECT * FROM KnowledgeStore
WHERE timestamp BETWEEN :from_timestamp AND :to_timestamp
AND (sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND holder = :viewer))
ORDER BY timestamp DESC;

-- Find knowledge written during a specific Arc run: the replay read ArcTraceProjection folds.
findKnowledgeByRunId:
SELECT * FROM KnowledgeStore
WHERE run_id = ? AND sensitivity != 'PROTECTED'
ORDER BY timestamp ASC;

-- Find knowledge by task type
findKnowledgeByTaskType:
SELECT * FROM KnowledgeStore
WHERE task_type = :task_type
AND (sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND holder = :viewer))
ORDER BY timestamp DESC
LIMIT :limit;

-- Find knowledge by single tag
findKnowledgeByTag:
SELECT k.* FROM KnowledgeStore k
INNER JOIN KnowledgeTag kt ON k.id = kt.knowledge_id
WHERE kt.tag = :tag
AND (k.sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND k.holder = :viewer))
ORDER BY k.timestamp DESC
LIMIT :limit;

-- Find knowledge by multiple tags (matches any of the provided tags)
findKnowledgeByTags:
SELECT DISTINCT k.* FROM KnowledgeStore k
INNER JOIN KnowledgeTag kt ON k.id = kt.knowledge_id
WHERE kt.tag IN :tags
AND (k.sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND k.holder = :viewer))
ORDER BY k.timestamp DESC
LIMIT :limit;

-- Full-text search in approach and learnings.
-- See link.socket.ampere.db.fts.searchKnowledgeByText for the raw-query replacement — this
-- can no longer be a SQLDelight query since `KnowledgeFts` isn't declared in this schema.

-- Fallback text search using LIKE for simple keyword matching
searchKnowledgeByTextLike:
SELECT * FROM KnowledgeStore
WHERE (approach LIKE '%' || :text || '%' OR learnings LIKE '%' || :text || '%')
AND (sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND holder = :viewer))
ORDER BY timestamp DESC
LIMIT :limit;

-- Combined context-based search with multiple optional filters
-- When tags list is empty, all entries match (LEFT JOIN returns all)
-- When tags list has values, only entries with matching tags are returned
searchKnowledgeByContextWithTags:
SELECT DISTINCT k.*
FROM KnowledgeStore k
LEFT JOIN KnowledgeTag kt ON k.id = kt.knowledge_id
WHERE (:knowledge_type IS NULL OR k.knowledge_type = :knowledge_type)
AND (:task_type IS NULL OR k.task_type = :task_type)
AND (:complexity_level IS NULL OR k.complexity_level = :complexity_level)
AND (:from_timestamp IS NULL OR k.timestamp >= :from_timestamp)
AND (:to_timestamp IS NULL OR k.timestamp <= :to_timestamp)
AND kt.tag IN :tags
AND (k.sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND k.holder = :viewer))
ORDER BY k.timestamp DESC
LIMIT :limit;

-- Combined search without tag filtering
searchKnowledgeByContextNoTags:
SELECT k.*
FROM KnowledgeStore k
WHERE (:knowledge_type IS NULL OR k.knowledge_type = :knowledge_type)
AND (:task_type IS NULL OR k.task_type = :task_type)
AND (:complexity_level IS NULL OR k.complexity_level = :complexity_level)
AND (:from_timestamp IS NULL OR k.timestamp >= :from_timestamp)
AND (:to_timestamp IS NULL OR k.timestamp <= :to_timestamp)
AND (k.sensitivity = 'PUBLIC' OR (:viewer IS NOT NULL AND k.holder = :viewer))
ORDER BY k.timestamp DESC
LIMIT :limit;

-- Get all knowledge entries ordered by timestamp. Unscoped — every row, PROTECTED included — so
-- it is a maintenance read, not a Subject's: nothing on a production path calls it.
getAllKnowledge:
SELECT * FROM KnowledgeStore
ORDER BY timestamp DESC;

-- Get knowledge count by type
getKnowledgeCountByType:
SELECT knowledge_type, COUNT(*)
FROM KnowledgeStore
GROUP BY knowledge_type;

-- Delete knowledge entry and all associations (cascade handled by FK)
deleteKnowledge:
DELETE FROM KnowledgeStore WHERE id = ?;

-- Delete tag association
deleteKnowledgeTag:
DELETE FROM KnowledgeTag WHERE knowledge_id = ? AND tag = ?;

-- Delete all tags for a knowledge entry
deleteAllTagsForKnowledge:
DELETE FROM KnowledgeTag WHERE knowledge_id = ?;
