CREATE TABLE PlugGrants (
  plug_id TEXT NOT NULL,
  permission_json TEXT NOT NULL,
  granted_at INTEGER NOT NULL,
  revoked_at INTEGER,
  PRIMARY KEY (plug_id, permission_json)
);

CREATE INDEX idx_plug_grants_plug_id ON PlugGrants(plug_id);

upsertGrant:
INSERT OR REPLACE INTO PlugGrants(plug_id, permission_json, granted_at, revoked_at)
VALUES (?, ?, ?, NULL);

revokeGrant:
INSERT OR REPLACE INTO PlugGrants(plug_id, permission_json, granted_at, revoked_at)
VALUES (?, ?, ?, ?);

listGrants:
SELECT plug_id, permission_json, granted_at, revoked_at
FROM PlugGrants
WHERE plug_id = ?
ORDER BY granted_at ASC;

countGrant:
SELECT COUNT(*)
FROM PlugGrants
WHERE plug_id = ? AND permission_json = ? AND revoked_at IS NULL;
